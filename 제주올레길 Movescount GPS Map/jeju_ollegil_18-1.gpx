      <rtept lat="33.9600" lon="126.3080"><ele>10</ele></rtept>
      <!-- Chuja Bridge (Crossing to Hachuja) -->
      <rtept lat="33.9555" lon="126.3055"><ele>10</ele></rtept>
      <!-- Muk-ri -->
      <rtept lat="33.9480" lon="126.3100"><ele>20</ele></rtept>
